{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mukezhiyu.local/contracts/workflow-response.schema.json",
  "title": "牧客智语工作流响应",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "success", "response_type", "response", "conversation_id",
    "case_data", "follow_up_round", "fourth_round_triggered", "fourth_round_reason", "diagnosis_attempts", "asked_questions", "pending_question_ids", "question_answers",
    "questions", "diagnosis", "locked_disease", "candidate_id",
    "solution_directions", "selected_direction", "product_category_tags",
    "management_directions", "management_advice", "company_product_categories",
    "prefer_company_product", "recommendation_status", "result_mode",
    "recommended_products", "emergency", "service_end_reason", "error", "meta"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "success": { "type": "boolean" },
    "response_type": {
      "enum": ["question", "diagnosis", "direction_selection", "product", "management", "no_match", "knowledge", "emergency", "out_of_scope", "service_end", "error"]
    },
    "response": { "type": "string" },
    "conversation_id": { "type": "string", "minLength": 1 },
    "case_data": { "$ref": "#/$defs/caseData" },
    "follow_up_round": { "type": "integer", "minimum": 0, "maximum": 4 },
    "fourth_round_triggered": { "type": "boolean" },
    "fourth_round_reason": { "type": ["string", "null"] },
    "diagnosis_attempts": { "type": "integer", "minimum": 0 },
    "asked_questions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "pending_question_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "question_answers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/questionAnswer" }
    },
    "questions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/question" } },
    "diagnosis": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/diagnosis" }] },
    "locked_disease": { "type": ["string", "null"] },
    "candidate_id": { "type": ["string", "null"] },
    "solution_directions": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/direction" } },
    "selected_direction": { "type": ["string", "null"] },
    "product_category_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "management_directions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "management_advice": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "company_product_categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "prefer_company_product": { "type": "boolean" },
    "recommendation_status": { "enum": ["not_started", "waiting_for_selection", "processing", "completed", "failed"] },
    "result_mode": { "type": ["string", "null"], "enum": ["product", "management", "no_match", null] },
    "recommended_products": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/product" } },
    "emergency": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/emergency" }] },
    "service_end_reason": { "type": ["string", "null"], "enum": ["testing_required", "vet_required", "customer_service", "follow_up_limit_reached", null] },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "allOf": [
    {
      "if": { "properties": { "response_type": { "const": "question" } } },
      "then": { "properties": { "questions": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "follow_up_round": { "const": 4 } } },
      "then": {
        "properties": {
          "fourth_round_triggered": { "const": true },
          "fourth_round_reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "questions": { "minItems": 3 } } },
      "then": { "properties": { "follow_up_round": { "const": 1 } } }
    }
  ],
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "caseData": {
      "type": "object",
      "additionalProperties": true,
      "required": ["animal", "user_reported_disease", "stage", "age", "symptoms", "duration", "morbidity", "mortality", "severity", "feces_color", "feces_shape", "temperature", "feeding_status", "drinking_status", "medication_history", "environment_change", "other_information", "information_status", "change_history", "conflicts", "raw_text"],
      "properties": {
        "animal": { "$ref": "#/$defs/nullableString" },
        "user_reported_disease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "statement_type"],
          "properties": {
            "name": { "type": "string" },
            "statement_type": { "type": "string" }
          }
        },
        "stage": { "type": "string" },
        "symptoms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "age": { "type": "string" },
        "duration": { "type": "string" },
        "morbidity": {
          "type": "object", "additionalProperties": false, "required": ["total_count", "affected_count"],
          "properties": { "total_count": { "type": "string" }, "affected_count": { "type": "string" } }
        },
        "mortality": {
          "type": "object", "additionalProperties": false, "required": ["death_count"],
          "properties": { "death_count": { "type": "string" } }
        },
        "severity": { "type": "string" },
        "temperature": { "type": "string" },
        "feeding_status": { "type": "string" },
        "drinking_status": { "type": "string" },
        "feces_color": { "type": "string" },
        "feces_shape": { "type": "string" },
        "medication_history": { "type": "string" },
        "environment_change": { "type": "string" },
        "other_information": { "type": "array", "items": { "type": "string" } },
        "information_status": {
          "type": "object",
          "additionalProperties": { "enum": ["user_provided", "not_provided", "unknown", "unclear", "unavailable", "conflict"] }
        },
        "change_history": { "type": "array" },
        "conflicts": { "type": "array" },
        "raw_text": { "type": "array", "items": { "type": "string" } }
      }
    },
    "questionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "other_text"],
      "properties": {
        "status": { "enum": ["pending", "answered", "unavailable", "invalid"] },
        "value": { "type": ["string", "null"] },
        "other_text": { "type": ["string", "null"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_field", "question", "question_type", "options", "allow_other", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target_field": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "question_type": { "enum": ["open", "single_choice"] },
        "options": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/option" } },
        "allow_other": { "type": "boolean" },
        "required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_type", "source_ref"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["user_input", "case_data", "knowledge_base"] },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disease_name", "display_title", "confidence", "evidence", "differential_notes", "missing_information", "risk_level", "warning"],
      "properties": {
        "disease_name": { "type": "string", "minLength": 1 },
        "display_title": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "differential_notes": { "type": "array", "items": { "type": "string" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "risk_level": { "enum": ["low", "medium", "high", "critical"] },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "target_problem", "mechanism", "expected_improvement", "direction_type", "priority", "product_category_tags", "company_product_categories", "prefer_company_product", "source_rule_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "target_problem": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "expected_improvement": { "type": "string", "minLength": 1 },
        "direction_type": { "enum": ["product", "management"] },
        "priority": { "type": "integer", "minimum": 1 },
        "product_category_tags": { "type": "array", "items": { "type": "string" } },
        "company_product_categories": { "type": "array", "items": { "type": "string" } },
        "prefer_company_product": { "type": "boolean" },
        "source_rule_id": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "product_name", "manufacturer", "product_category", "features", "recommendation_reason", "usage", "precautions", "source_id"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "product_name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "product_category": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "type": "string" } },
        "recommendation_reason": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "precautions": { "type": "array", "items": { "type": "string" } },
        "official_website": { "type": ["string", "null"], "pattern": "^https?://" },
        "contact_info": { "type": ["string", "null"] },
        "purchase_url": { "type": ["string", "null"], "pattern": "^https?://" },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "emergency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emergency_type", "risk_level", "title", "actions", "stop_recommendation"],
      "properties": {
        "emergency_type": { "type": "string", "minLength": 1 },
        "risk_level": { "const": "critical" },
        "title": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stop_recommendation": { "const": true }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["INVALID_REQUEST", "UNAUTHORIZED", "WORKFLOW_TIMEOUT", "WORKFLOW_FAILED", "INVALID_RESPONSE", "KNOWLEDGE_UNAVAILABLE", "DUPLICATE_SUBMISSION"] },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "workflow_version"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "workflow_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
